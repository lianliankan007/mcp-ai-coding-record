APP_NAME=memory-mcp-server
HOST=0.0.0.0
PORT=8080

QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=coding_memory

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=30

MEMORY_DEDUP_ENABLED=true
MEMORY_DEDUP_SIMILARITY_THRESHOLD=0.985
MEMORY_SUMMARY_MAX_CHARS=2000
DEFAULT_TOP_K=5
PERF_METRICS_ENABLED=false
PERF_BUDGET_SEARCH_MS=800
PERF_BUDGET_INGEST_MS=1200
PERF_BUDGET_RECENT_MS=200
